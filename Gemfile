source "https://rubygems.org"

# Jekyll 3.9.x is compatible with the system Ruby (2.6) on this machine and
# matches the Jekyll 3.x line GitHub Pages builds with. The site uses no
# plugins or themes, so this is all that's needed for a faithful local preview.
gem "jekyll", "~> 3.9.5"

# Pin native/transitive gems to versions compatible with Ruby 2.6.
gem "ffi", "~> 1.15.5"
